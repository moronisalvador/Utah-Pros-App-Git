# ════════════════════════════════════════════════
# FILE: ios/fastlane/Appfile
# ════════════════════════════════════════════════
#
# WHAT THIS DOES (plain language):
#   Identifies the iOS app and passes the owner-provided Apple team ID to
#   fastlane without storing account credentials in source control.
#
# DEPENDS ON:
#   Internal:  ios/App/App.xcodeproj/project.pbxproj
#   Data:      reads  → APPLE_TEAM_ID
#              writes → none
#
# NOTES / GOTCHAS:
#   - App Store Connect authentication belongs only to the Fastfile upload
#     lane and uses an API key; no Apple ID password path is configured.
# ════════════════════════════════════════════════

app_identifier("com.utahprosrestoration.upr")
team_id(ENV["APPLE_TEAM_ID"])
