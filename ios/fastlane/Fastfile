# ════════════════════════════════════════════════
# FILE: ios/fastlane/Fastfile
# ════════════════════════════════════════════════
#
# WHAT THIS DOES (plain language):
#   Creates an App Store archive for either the official UPR app or the
#   separately identified UPR Dev app, then exports it with that variant's
#   named distribution profile. A separate lane can upload an already
#   verified IPA to internal TestFlight. Archive creation never contacts
#   App Store Connect.
#
# DEPENDS ON:
#   Packages:  fastlane 2.237.0 (ios/Gemfile + reviewed Gemfile.lock)
#   Internal:  ios/App/App.xcodeproj, ios/fastlane/Appfile
#   Data:      reads  → explicit CI environment variables and signing files
#              writes → ios/build/ plus one temporary CI keychain
#
# NOTES / GOTCHAS:
#   - The official UPR GitHub workflow remains manual-only and main-only.
#   - UPR_RELEASE_VARIANT is allowlisted; the default remains production.
#   - Signing assets must already exist as runner-temporary files.
#   - TestFlight authentication is accepted only by the upload lane.
#   - TestFlight upload/install and production delivery remain external gates.
# ════════════════════════════════════════════════

require "fileutils"
require "shellwords"

default_platform(:ios)

RELEASE_VARIANTS = {
  "production" => {
    app_identifier: "com.utahprosrestoration.upr",
    scheme: "App",
    configuration: "Release",
    artifact_basename: "UPR",
    profile_setting: "UPR_RELEASE_PROFILE_NAME",
    # "UPR Technicians" is the app's only internal TestFlight group and has
    # auto-distribution disabled, so an upload that names no group leaves the
    # build VALID-but-invisible in App Store Connect. Verified live 2026-08-06:
    # builds 184.1/185.1/193.1/194.1 all processed and sat unassigned while
    # fastlane reported success. Naming the group also disables
    # skip_waiting_for_build_processing, so upload success now means delivered.
    internal_group: "UPR Technicians",
  }.freeze,
  "dev" => {
    app_identifier: "com.utahprosrestoration.upr.dev",
    scheme: "UPR Dev TestFlight",
    configuration: "DevRelease",
    artifact_basename: "UPR-Dev",
    profile_setting: "UPR_DEV_RELEASE_PROFILE_NAME",
    internal_group: "UPR Dev",
  }.freeze,
}.freeze

RELEASE_VARIANT_NAME = ENV.fetch("UPR_RELEASE_VARIANT", "production")
RELEASE_VARIANT = RELEASE_VARIANTS.fetch(RELEASE_VARIANT_NAME) do
  raise ArgumentError, "Unsupported UPR_RELEASE_VARIANT: #{RELEASE_VARIANT_NAME}"
end
APP_IDENTIFIER = RELEASE_VARIANT.fetch(:app_identifier)
SCHEME = RELEASE_VARIANT.fetch(:scheme)
BUILD_CONFIGURATION = RELEASE_VARIANT.fetch(:configuration)
ARTIFACT_BASENAME = RELEASE_VARIANT.fetch(:artifact_basename)
PROFILE_SETTING = RELEASE_VARIANT.fetch(:profile_setting)
INTERNAL_GROUP = RELEASE_VARIANT.fetch(:internal_group)
IOS_ROOT = File.expand_path("..", __dir__)
XCODE_PROJECT = File.join(IOS_ROOT, "App", "App.xcodeproj")
BUILD_DIRECTORY = File.join(IOS_ROOT, "build")
ARCHIVE_PATH = File.join(BUILD_DIRECTORY, "#{ARTIFACT_BASENAME}.xcarchive")
IPA_PATH = File.join(BUILD_DIRECTORY, "#{ARTIFACT_BASENAME}.ipa")

def required_environment!(name)
  value = ENV[name].to_s.strip
  UI.user_error!("Missing required environment variable: #{name}") if value.empty?
  value
end

def required_file!(name)
  path = File.expand_path(required_environment!(name))
  UI.user_error!("#{name} does not point to a readable file") unless File.file?(path)
  path
end

def xcode_assignment(name, value)
  "#{name}=#{Shellwords.escape(value)}"
end

platform :ios do
  desc "Create and manually export an App Store archive without contacting App Store Connect"
  lane :archive do
    team_id = required_environment!("APPLE_TEAM_ID")
    certificate_path = required_file!("APPLE_CERTIFICATE_PATH")
    certificate_password = required_environment!("APPLE_CERTIFICATE_PASSWORD")
    provisioning_profile_path = required_file!("APPLE_PROVISIONING_PROFILE_PATH")
    provisioning_profile_name = required_environment!("APPLE_PROVISIONING_PROFILE_NAME")
    keychain_password = required_environment!("KEYCHAIN_PASSWORD")
    build_number = required_environment!("BUILD_NUMBER")

    run_id = ENV["GITHUB_RUN_ID"].to_s.gsub(/[^0-9A-Za-z_-]/, "")
    run_id = "local" if run_id.empty?
    keychain_name = "upr-ios-release-#{run_id}.keychain-db"
    keychain_created = false
    installed_profile_path = nil
    archive_error = nil

    FileUtils.mkdir_p(BUILD_DIRECTORY)
    FileUtils.rm_f(IPA_PATH)

    signing_settings = [
      xcode_assignment("DEVELOPMENT_TEAM", team_id),
      xcode_assignment(PROFILE_SETTING, provisioning_profile_name),
      xcode_assignment("CURRENT_PROJECT_VERSION", build_number),
    ].join(" ")

    begin
      create_keychain(
        name: keychain_name,
        password: keychain_password,
        default_keychain: false,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: true,
        add_to_search_list: true
      )
      keychain_created = true

      import_certificate(
        certificate_path: certificate_path,
        certificate_password: certificate_password,
        keychain_name: keychain_name,
        keychain_password: keychain_password
      )

      installed_profile_path = install_provisioning_profile(
        path: provisioning_profile_path
      )

      build_app(
        project: XCODE_PROJECT,
        scheme: SCHEME,
        configuration: BUILD_CONFIGURATION,
        clean: true,
        destination: "generic/platform=iOS",
        archive_path: ARCHIVE_PATH,
        derived_data_path: File.join(BUILD_DIRECTORY, "DerivedData"),
        output_directory: BUILD_DIRECTORY,
        output_name: File.basename(IPA_PATH),
        export_method: "app-store",
        export_team_id: team_id,
        skip_profile_detection: true,
        disable_package_automatic_updates: true,
        skip_package_repository_fetches: true,
        include_symbols: true,
        xcargs: signing_settings,
        export_options: {
          signingStyle: "manual",
          teamID: team_id,
          signingCertificate: "Apple Distribution",
          provisioningProfiles: {
            APP_IDENTIFIER => provisioning_profile_name
          }
        }
      )

      UI.user_error!("Expected IPA was not created at #{IPA_PATH}") unless File.file?(IPA_PATH)
    rescue StandardError => error
      archive_error = error
      raise
    ensure
      cleanup_error = nil

      if installed_profile_path
        begin
          FileUtils.rm_f(installed_profile_path)
        rescue StandardError => profile_cleanup_error
          cleanup_error ||= profile_cleanup_error
          UI.error(
            "Failed to delete the installed provisioning profile " \
            "(#{profile_cleanup_error.class})"
          )
        end
      end

      if keychain_created
        begin
          delete_keychain(name: keychain_name)
        rescue StandardError => keychain_cleanup_error
          cleanup_error ||= keychain_cleanup_error
          UI.error(
            "Failed to delete the temporary release keychain " \
            "(#{keychain_cleanup_error.class})"
          )
        end
      end

      raise cleanup_error if archive_error.nil? && cleanup_error
    end
  end

  desc "Upload an already verified IPA to internal TestFlight"
  lane :upload do
    ipa_path = required_file!("IPA_PATH")
    api_key = app_store_connect_api_key(
      key_id: required_environment!("ASC_KEY_ID"),
      issuer_id: required_environment!("ASC_ISSUER_ID"),
      key_content: required_environment!("ASC_KEY_CONTENT_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    upload_options = {
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: ipa_path,
      skip_waiting_for_build_processing: INTERNAL_GROUP.nil?,
      distribute_external: false,
      submit_beta_review: false,
      notify_external_testers: false,
    }
    upload_options[:groups] = [INTERNAL_GROUP] if INTERNAL_GROUP

    upload_to_testflight(**upload_options)
  end

  desc "Assign an already uploaded, fully processed build to an internal TestFlight group"
  lane :distribute do
    require "base64"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: required_environment!("ASC_KEY_ID"),
      issuer_id: required_environment!("ASC_ISSUER_ID"),
      key: Base64.decode64(required_environment!("ASC_KEY_CONTENT_BASE64")),
      in_house: false
    )
    build_number = required_environment!("DISTRIBUTE_BUILD_NUMBER")
    group_name = required_environment!("DISTRIBUTE_GROUP")

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("No App Store Connect app found for #{APP_IDENTIFIER}") unless app

    group = app.get_beta_groups.find { |candidate| candidate.name == group_name }
    UI.user_error!("No beta group named #{group_name.inspect} on #{app.name}") unless group

    build = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      build_number: build_number,
      sort: "-uploadedDate",
      limit: 5
    ).find { |candidate| candidate.version == build_number }
    UI.user_error!("No build #{build_number} found for #{APP_IDENTIFIER}") unless build
    unless build.processing_state == "VALID"
      UI.user_error!("Build #{build_number} is not distributable (state=#{build.processing_state})")
    end

    build.add_beta_groups(beta_groups: [group])
    UI.success("Assigned build #{build_number} to internal group #{group_name.inspect}")
  end

  desc "Re-send an expired App Store Connect user invitation, preserving its recorded attributes"
  lane :reinvite do
    require "base64"
    require "json"
    require "jwt"
    require "net/http"
    require "openssl"

    email = required_environment!("REINVITE_EMAIL").downcase
    signing_key = OpenSSL::PKey.read(Base64.decode64(required_environment!("ASC_KEY_CONTENT_BASE64")))
    bearer = JWT.encode(
      { iss: required_environment!("ASC_ISSUER_ID"), aud: "appstoreconnect-v1", exp: Time.now.to_i + 600 },
      signing_key,
      "ES256",
      { kid: required_environment!("ASC_KEY_ID") }
    )
    http = Net::HTTP.new("api.appstoreconnect.apple.com", 443)
    http.use_ssl = true
    http.open_timeout = 30
    http.read_timeout = 60
    call_api = lambda do |request_class, path, body = nil|
      request = request_class.new(path)
      request["Authorization"] = "Bearer #{bearer}"
      request["Content-Type"] = "application/json"
      request.body = JSON.generate(body) if body
      response = http.request(request)
      parsed = response.body.to_s.empty? ? {} : JSON.parse(response.body)
      [response.code.to_i, parsed]
    end

    status, users = call_api.call(Net::HTTP::Get, "/v1/users?filter[username]=#{email}&limit=2")
    UI.user_error!("User lookup failed: HTTP #{status}") unless status == 200
    if (users["data"] || []).any?
      UI.success("#{email} is already an active App Store Connect user — no invitation needed.")
      next
    end

    status, invitations = call_api.call(Net::HTTP::Get, "/v1/userInvitations?filter[email]=#{email}&limit=2")
    UI.user_error!("Invitation lookup failed: HTTP #{status}") unless status == 200
    invitation = (invitations["data"] || []).first
    unless invitation
      UI.user_error!(
        "No existing invitation or active user found for #{email}. " \
        "A first-time invitation carries owner-chosen roles, so it is not automated here."
      )
    end

    attributes = invitation["attributes"] || {}
    UI.message(
      "Found invitation #{invitation['id']}: roles=#{attributes['roles']} " \
      "expires=#{attributes['expirationDate']} allApps=#{attributes['allAppsVisible']}"
    )

    visible_app_ids = []
    unless attributes["allAppsVisible"]
      status, visible = call_api.call(
        Net::HTTP::Get, "/v1/userInvitations/#{invitation['id']}/visibleApps?limit=50"
      )
      UI.user_error!("Visible-apps lookup failed: HTTP #{status}") unless status == 200
      visible_app_ids = (visible["data"] || []).map { |app| app["id"] }
    end

    status, = call_api.call(Net::HTTP::Delete, "/v1/userInvitations/#{invitation['id']}")
    UI.user_error!("Could not delete the expired invitation: HTTP #{status}") unless [200, 204].include?(status)

    payload = {
      data: {
        type: "userInvitations",
        attributes: {
          email: attributes["email"] || email,
          firstName: attributes["firstName"],
          lastName: attributes["lastName"],
          roles: attributes["roles"],
          allAppsVisible: attributes["allAppsVisible"],
          provisioningAllowed: attributes["provisioningAllowed"],
        },
      },
    }
    if !attributes["allAppsVisible"] && !visible_app_ids.empty?
      payload[:data][:relationships] = {
        visibleApps: { data: visible_app_ids.map { |app_id| { type: "apps", id: app_id } } },
      }
    end
    status, created = call_api.call(Net::HTTP::Post, "/v1/userInvitations", payload)
    UI.user_error!("Re-invitation failed: HTTP #{status} #{created}") unless status == 201
    UI.success("Fresh App Store Connect invitation sent to #{email} (roles=#{attributes['roles']}).")
  end

  desc "Read-only App Store Connect diagnosis: beta groups and recent build states"
  lane :diagnose do
    require "base64"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: required_environment!("ASC_KEY_ID"),
      issuer_id: required_environment!("ASC_ISSUER_ID"),
      key: Base64.decode64(required_environment!("ASC_KEY_CONTENT_BASE64")),
      in_house: false
    )

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("No App Store Connect app found for #{APP_IDENTIFIER}") unless app
    UI.message("APP: #{app.name} (#{app.id}) bundle=#{app.bundle_id}")

    app.get_beta_groups.each do |group|
      details = %i[is_internal_group has_access_to_all_builds public_link_enabled].map do |attribute|
        value = begin
          group.public_send(attribute)
        rescue StandardError
          "n/a"
        end
        "#{attribute}=#{value}"
      end
      UI.message("GROUP: #{group.name.inspect} #{details.join(' ')}")
    end

    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      includes: "preReleaseVersion,betaGroups",
      sort: "-uploadedDate",
      limit: 20
    )
    builds.first(20).each do |build|
      version = begin
        build.pre_release_version&.version
      rescue StandardError
        "?"
      end
      group_names = begin
        (build.beta_groups || []).map(&:name).join("|")
      rescue StandardError
        ""
      end
      UI.message(
        "BUILD: #{version} (#{build.version}) state=#{build.processing_state} " \
        "uploaded=#{build.uploaded_date} expired=#{build.expired} groups=[#{group_names}]"
      )
    end
  end
end
