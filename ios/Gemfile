#   is allowed to install dependencies or handle signing material.
#
# NOTES / GOTCHAS:
#   - Version 2.237.0 is the reviewed release for the pinned Ruby 3.3 CI
#     toolchain. Regenerate and review Gemfile.lock on that toolchain after
#     intentional dependency changes.
# ════════════════════════════════════════════════

source "https://rubygems.org"

ruby "3.3.12"

gem "fastlane", "2.237.0"
