{
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/install_pkgs.sh\"",
            "statusMessage": "Installing dependencies (cloud sessions only)..."
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/record-instructions-loaded.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-secrets.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__.*__(apply_migration|execute_sql|exec_read_sql|upr_sql|upr_insert|upr_update|upr_upsert|upr_delete)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-destructive-sql.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-main-push.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Agent",
      "Skill",
      "ToolSearch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npx eslint:*)",
      "Bash(npx vitest:*)",
      "Bash(mkdir:*)",
      "Bash(chmod:*)",
      "Bash(ls:*)",
      "mcp__Supabase__list_tables",
      "mcp__Supabase__list_migrations",
      "mcp__Supabase__list_extensions",
      "mcp__Supabase__get_advisors",
      "mcp__Supabase__get_logs",
      "mcp__Supabase__generate_typescript_types",
      "mcp__Supabase__get_project_url",
      "mcp__Supabase__get_publishable_keys",
      "mcp__UPR_MCP__upr_schema",
      "mcp__UPR_MCP__upr_describe",
      "mcp__UPR_MCP__upr_select",
      "mcp__UPR_MCP__upr_search",
      "mcp__UPR_MCP__upr_code_context",
      "mcp__github__pull_request_read",
      "mcp__github__get_file_contents",
      "mcp__github__get_commit",
      "mcp__github__list_commits",
      "mcp__github__list_pull_requests",
      "mcp__github__list_branches",
      "mcp__github__get_job_logs",
      "mcp__github__actions_get",
      "mcp__github__actions_list"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main)",
      "mcp__*__exec_read_sql",
      "mcp__*__upr_sql",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "mcp__*__upr_delete",
      "mcp__*__upr_update",
      "mcp__*__run_payroll",
      "mcp__*__qbo_delete_invoice",
      "mcp__*__qbo_delete_entity",
      "mcp__*__qbo_delete_payment",
      "mcp__*__qbo_sales_delete_invoice",
      "mcp__*__qbo_sales_delete_estimate",
      "mcp__*__qbo_sales_delete_recurring_invoice"
    ],
    "ask": [
      "mcp__*__apply_migration",
      "mcp__*__execute_sql",
      "mcp__*__merge_pull_request",
      "mcp__*__github_merge_pr",
      "mcp__*__stripe_create_payout",
      "mcp__*__twilio_send_sms"
    ]
  }
}
