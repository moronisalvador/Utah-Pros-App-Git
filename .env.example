# Frontend environment variables (Vite)
# Copy to .env.local for local development
# In production, set in Cloudflare Pages Dashboard → Settings → Environment Variables

# Supabase — public anon key (safe for frontend)
VITE_SUPABASE_URL=https://glsmljpabrwonfiltiqm.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Native APNs enrollment — intentionally OFF unless the reviewed native release
# has completed provider, lifecycle, signing, and real-device verification.
VITE_NATIVE_PUSH_ENABLED=false
# Native development builds use sandbox; TestFlight/App Store builds use
# production. Missing or any other value keeps native enrollment off.
VITE_APNS_ENV=sandbox
VITE_NATIVE_OTA_ENABLED=false

# Grouped QuickBooks Receive Payment UI rollout. Set to literal true only in a
# reviewed Preview build; Production and native builds stay dark by default.
VITE_QBO_RECEIVE_PAYMENT_UI_ENABLED=false

# Google Maps Places API — enables address autocomplete on customer/job/claim forms.
# Must have both "Maps JavaScript API" and "Places API (New)" enabled, and be
# restricted to HTTP referrers (utahpros.com, *.pages.dev, localhost:5173).
# If unset, address inputs fall back to plain text entry (no autocomplete).
VITE_GOOGLE_MAPS_API_KEY=
